# ─────────────────────────────────────────────────────────────────────────────
# Server sizing profiles for /srv/aurora/shared/.env
# ─────────────────────────────────────────────────────────────────────────────
#
# Everything in this file answers ONE question: how many processes may run, and
# how much memory may each of them assume?
#
# READ THIS BEFORE COPYING ANYTHING BELOW
#
# These are sizing knobs ONLY. Not one of them touches how much *work* the
# system schedules for itself. Specifically, moving to a bigger server does NOT
# and MUST NOT re-enable any of the following. They stay exactly as they are
# unless you deliberately change them, and none of them appears in the profiles
# below:
#
#     HEALTH_MONITORING_ENABLED          (stays false)
#     HEALTH_SERVER_CHECK_INTERVAL_SECONDS
#     HEALTH_API_CHECK_INTERVAL_SECONDS
#     HEALTH_PAYMENT_CHECK_INTERVAL_SECONDS
#     NOTIFICATION_RETRY_INTERVAL_SECONDS
#     NOTIFICATION_RETRY_LOGS_INTERVAL_SECONDS
#     RAZORPAY_STALE_CLEANUP_INTERVAL_SECONDS
#     HEALTH_RESULT_RETENTION_DAYS
#
# The beat schedule went from 157 executions/hour to 12 for reasons that had
# nothing to do with how big the box was: half of it was work that was failing
# by construction, writing to a table nothing pruned. A bigger server does not
# make useless work useful. If you ever want health collection back, turn it on
# by itself, on purpose, and watch what it costs -- do not bundle it into a
# hardware upgrade.
#
# ─────────────────────────────────────────────────────────────────────────────
# Profile A — 1 vCPU / 1 GB  (these are the built-in defaults)
# ─────────────────────────────────────────────────────────────────────────────
#
# Nothing to set. The defaults compiled into docker-compose.prod.yml are this
# profile. Listed here so the numbers are visible in one place.
#
#   GUNICORN_WORKERS=1
#   GUNICORN_THREADS=8
#   CELERY_POOL=solo
#   CELERY_CONCURRENCY=1
#   PG_MAX_CONNECTIONS=30
#   PG_SHARED_BUFFERS=96MB
#   PG_EFFECTIVE_CACHE_SIZE=256MB
#   PG_WORK_MEM=4MB
#   PG_MAINTENANCE_WORK_MEM=32MB
#   PG_AUTOVACUUM_MAX_WORKERS=1
#
# Requires a 2 GB swapfile. Headroom is roughly 65 MB; without swap, a spike
# OOM-kills a container rather than degrading.

# ─────────────────────────────────────────────────────────────────────────────
# Profile B — 2 vCPU / 2 GB / NVMe   <-- copy these into .env on that server
# ─────────────────────────────────────────────────────────────────────────────
#
# Budget: ~1.58 GB used of ~1.95 GB usable, leaving ~370 MB headroom.
#
#   host + docker       250 MB
#   postgres            300 MB
#   gunicorn 2x4        460 MB
#   celery prefork c=1  360 MB   (worker + one child; beat embedded)
#   redis + 2x nginx     45 MB

GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# prefork, not solo. This is the point of the upgrade for Celery: prefork
# implements soft_time_limit/time_limit with signals into child processes, and
# those limits are NOT enforced under the solo pool. Restoring prefork means a
# task that hangs gets killed instead of blocking every other task forever.
CELERY_POOL=prefork
CELERY_CONCURRENCY=1

PG_MAX_CONNECTIONS=40
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_AUTOVACUUM_MAX_WORKERS=2
PG_MAX_WAL_SIZE=1GB
PG_MIN_WAL_SIZE=256MB

# NVMe. The Postgres defaults (random_page_cost=4.0, effective_io_concurrency=1)
# describe a spinning disk: 4.0 tells the planner a random read costs four times
# a sequential one, which biases it away from index scans that are nearly free
# on NVMe. This is not a memory setting and it is worth setting on its own.
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200

# Connection ceiling check: workers x threads (2 x 4 = 8) + celery (2) + beat (1)
# + a psql session or two ~= 12 against PG_MAX_CONNECTIONS=40. Comfortable.
# If you raise GUNICORN_WORKERS or GUNICORN_THREADS, redo that arithmetic.
