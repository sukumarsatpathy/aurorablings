# Environment for docker-compose.local-prod.yml -- running the PRODUCTION
# images against a LOCAL database. Copy to .env.local-prod and adjust.
#
# Do NOT just reuse the server's .env. prod.py enables SSL redirect, secure
# cookies and HSTS by default, none of which work over http://localhost.
#
#   cp .env.local-prod.example .env.local-prod
#   docker compose -f docker-compose.local-prod.yml --env-file .env.local-prod up -d

# ── Django core ───────────────────────────────────────────────
# prod.py reads these with env.list() and NO default -- omit them and Django
# raises ImproperlyConfigured at import time.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=local-prod-image-testing-not-a-real-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ENABLE_DJANGO_ADMIN=True

# ── Security: relaxed because this is plain http on localhost ──
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── Database (must match docker-compose.local-prod.yml) ───────
POSTGRES_DB=aurora_db
POSTGRES_USER=aurora_user
POSTGRES_PASSWORD=admin

# ── Redis / Celery ────────────────────────────────────────────
# Must be the compose service name, not localhost. base.py defaults
# REDIS_URL to localhost:6379, which inside the container is the backend
# container itself -- connection refused on every cached request.
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Paths inside the container ────────────────────────────────
STATIC_URL=/static/
MEDIA_URL=/media/
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
# NOTE: prod.py line 35 reads DJANGO_LOGGING_DIR, not DJANGO_LOG_DIR.
# .env.example gets this name wrong and the value is silently ignored.
DJANGO_LOGGING_DIR=/app/logs

BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# ── Email: console backend, so nothing is ever actually sent ──
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Aurora Blings <noreply@localhost>
ADMINS_EMAIL=

# ── Third-party: leave blank / sandbox. Never live keys here. ─
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
TURNSTILE_ENABLED=False
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NIMBUSPOST_API_KEY=
NIMBUSPOST_WEBHOOK_SECRET=

# ── Misc ──────────────────────────────────────────────────────
IMAGE_UPLOAD_MAX_BYTES=5242880
PRIVACY_STORE_IP_ADDRESS=False
